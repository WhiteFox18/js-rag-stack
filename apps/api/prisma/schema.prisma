generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum MessageRole {
  USER
  ASSISTANT
}

enum MessageStatus {
  STREAMING
  COMPLETED
  FAILED
  CANCELLED
}

enum TokenCountSource {
  OLLAMA_REPORTED
  ESTIMATED
  UNKNOWN
}

model User {
  id            String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email         String        @unique @db.VarChar(320)
  password_hash String        @db.Text
  display_name  String?       @db.VarChar(100)
  created_at    DateTime      @default(now()) @db.Timestamptz(3)
  updated_at    DateTime      @updatedAt @db.Timestamptz(3)
  chats         Chat[]        @relation("user_chats")
  auth_sessions AuthSession[] @relation("user_auth_sessions")

  @@map("user")
}

model AnonymousSession {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  token_hash   String   @unique @db.Char(64)
  expires_at   DateTime @db.Timestamptz(3)
  created_at   DateTime @default(now()) @db.Timestamptz(3)
  last_seen_at DateTime @default(now()) @db.Timestamptz(3)
  chats        Chat[]   @relation("anonymous_session_chats")

  @@index([expires_at])
  @@map("anonymous_session")
}

model AuthSession {
  id                     String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  user_id                String       @db.Uuid
  refresh_token_hash     String       @unique @db.Char(64)
  refresh_jti            String       @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  user_agent             String?      @db.VarChar(512)
  ip_hash                String?      @db.Char(64)
  expires_at             DateTime     @db.Timestamptz(3)
  revoked_at             DateTime?    @db.Timestamptz(3)
  replaced_by_session_id String?      @unique @db.Uuid
  created_at             DateTime     @default(now()) @db.Timestamptz(3)
  last_used_at           DateTime     @default(now()) @db.Timestamptz(3)
  user                   User         @relation("user_auth_sessions", fields: [user_id], references: [id], onDelete: Cascade)
  replaced_by            AuthSession? @relation("auth_session_rotation", fields: [replaced_by_session_id], references: [id], onDelete: SetNull)
  replaces               AuthSession? @relation("auth_session_rotation")

  @@index([user_id])
  @@index([refresh_jti])
  @@index([expires_at])
  @@map("auth_session")
}

model Chat {
  id                   String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  user_id              String?           @db.Uuid
  anonymous_session_id String?           @db.Uuid
  title                String            @db.VarChar(200)
  selected_model       String            @db.VarChar(200)
  created_at           DateTime          @default(now()) @db.Timestamptz(3)
  updated_at           DateTime          @updatedAt @db.Timestamptz(3)
  last_message_at      DateTime          @default(now()) @db.Timestamptz(3)
  archived_at          DateTime?         @db.Timestamptz(3)
  user                 User?             @relation("user_chats", fields: [user_id], references: [id], onDelete: Cascade)
  anonymous_session    AnonymousSession? @relation("anonymous_session_chats", fields: [anonymous_session_id], references: [id], onDelete: Cascade)
  messages             Message[]         @relation("chat_messages")

  @@index([user_id, last_message_at])
  @@index([anonymous_session_id, last_message_at])
  @@map("chat")
}

model Message {
  id                 String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  chat_id            String           @db.Uuid
  role               MessageRole
  status             MessageStatus
  content            String           @db.Text
  model              String?          @db.VarChar(200)
  token_count        Int?
  token_count_source TokenCountSource @default(UNKNOWN)
  prompt_tokens      Int?
  completion_tokens  Int?
  total_tokens       Int?
  finish_reason      String?          @db.VarChar(100)
  error_code         String?          @db.VarChar(100)
  created_at         DateTime         @default(now()) @db.Timestamptz(3)
  updated_at         DateTime         @updatedAt @db.Timestamptz(3)
  chat               Chat             @relation("chat_messages", fields: [chat_id], references: [id], onDelete: Cascade)

  @@index([chat_id, created_at, id])
  @@map("message")
}
